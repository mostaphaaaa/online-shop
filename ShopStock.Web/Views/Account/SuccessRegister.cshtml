@using ShopStock.Domain.ViewModels.Account
@model RegisterViewModel
@{
    ViewData["Title"] = "اتمام ثبت نام";
}
<div class="container">
    <div class="alert alert-success p-3">
        <h2>@Model.UserName خوش آمدید</h2>
        <p>
            با تشکر از ثبت نام شما ، ایمیلی حاوی لینک فعالسازی به ایمیل '@Model.Email' ارسال شد .
        </p>
        <p class=" text-muted">
            لطفا وارد ایمیل خود شده و اکانت را فعال کنید تا بتوانید از امکانات سایت استفاده کنید
        </p>
    </div>
</div>