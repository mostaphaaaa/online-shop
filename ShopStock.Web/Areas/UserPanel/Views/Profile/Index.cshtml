@using ShopStock.Domain.ViewModels.Account
@model ProfileViewModel
@{
    ViewData["Title"] = "ویرایش پروفایل";
}

<div class="row ui-box" style="padding:0;padding-bottom:15px">
    <h1>@ViewData["Title"]</h1>
    <hr />
    <form class="row" asp-action="Index" enctype="multipart/form-data">
        <div class="col-md-8">
            <input type="hidden" asp-for="Avatar" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control mt-1" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control mt-1" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Mobile" class="control-label mt-1"></label>
                <input asp-for="Mobile" class="form-control" />
                <span asp-validation-for="Mobile" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NationalCode" class="control-label mt-1"></label>
                <input asp-for="NationalCode" class="form-control" />
                <span asp-validation-for="NationalCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="ذخیره تغییرات" class="btn btn-success mt-3" />
            </div>

        </div>
        <div class="col-md-4">
            <h2>تصویر پروفایل</h2>
            <hr />
            <img id="imgAvatar" src="/Avatars/@Model.Avatar" class="img-thumbnail" />
            <input type="file" id="AvatarUp" name="imgAvatar" onchange="ShowpImage(this);" />
            @* قسمت 29 *@
            @if (ViewBag.ValidateImage != null)
            {
                <div class="alert alert-danger">
                    تصویر معتبر نمیباشد
                </div>
            }
        </div>
    </form>
</div>
