@using ShopStock.Domain.ViewModels.Common
@model PagingViewModel
<ul class="pagination justify-content-end">
    @if (Model.StartPage < Model.PageId)
    {
        <li class="paginate_button page-item previous" id="DataTables_Table_0_previous">
            <a href="@ViewBag.Url?PageId=@(Model.PageId - 1)&TakeEntity=@Model.TakeEntity" class="page-link">
                <i class="fa fa-chevron-left"></i>
            </a>
        </li>
    }

    @for (int i = Model.StartPage; i <= Model.EndPage; i++)
    {
        <li class="paginate_button page-item @((Model.PageId == i) ? "active" : "")">
            <a href="@ViewBag.Url?PageId=@i&TakeEntity=@Model.TakeEntity" aria-controls="DataTables_Table_0" data-dt-idx="0" tabindex="0" class="page-link">@i</a>
        </li>
    }
    @if (Model.EndPage > Model.PageId)
    {
        <li class="paginate_button page-item next" id="DataTables_Table_0_next">
            <a href="@ViewBag.Url?PageId=@(Model.PageId + 1)&TakeEntity=@Model.TakeEntity" class="page-link">
                <i class="fa fa-chevron-right"></i>
            </a>
        </li>
    }
</ul>