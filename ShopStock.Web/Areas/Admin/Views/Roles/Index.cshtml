@model IEnumerable<ShopStock.Domain.Models.Roles.Role>

@{
    ViewData["Title"] = "مدیریت نقش ها";
}
<style>
    .hidden {
        display: none !important;
    }

    /* بک‌گراند شیشه‌ای */
    .modal-overlay {
        position: fixed;
        inset: 0;
        backdrop-filter: blur(12px);
        background: rgba(0,0,0,0.35);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 99999;
        animation: fadeIn .25s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    /* خود باکس مودال */
    .modal-box {
        width: 360px;
        padding: 25px;
        text-align: center;
        color: #fff;
        background: rgba(255,255,255,0.10);
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,0.3);
        backdrop-filter: blur(25px);
        box-shadow: 0 8px 40px rgba(0,0,0,0.4), 0 0 20px rgba(255,255,255,0.4);
        animation: popup .25s ease forwards;
        transform: scale(0.8);
        opacity: 0;
    }

    .modal-box h3 {
            color: #ff6b6b; /* رنگ قرمز ملایم */
            font-weight: bold;
            margin-bottom: 20px;
            font-size: 1.3rem;
    }

    @@keyframes popup {
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-actions {
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
    }

    /* دکمه حذف (گرادینت) */
    .btn-gradient {
        flex: 1;
        margin-right: 5px;
        background: linear-gradient(135deg, #ff4d4d, #ff9068);
        padding: 10px 18px;
        border-radius: 10px;
        border: none;
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition: .2s;
    }

        .btn-gradient:hover {
            transform: scale(1.05);
        }

    /* دکمه انصراف */
    .btn-cancel {
        flex: 1;
        margin-left: 5px;
        margin-right: 10px;
        background: rgba(255,255,255,0.25);
        padding: 10px 18px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.4);
        color: white;
        cursor: pointer;
        transition: .2s;
    }

        .btn-cancel:hover {
            background: rgba(255,255,255,0.35);
        }

    .fade-out-row {
        transition: opacity 1s ease, height 1s ease;
        opacity: 0;
        height: 0;
        overflow: hidden;
    }

    /* حالت اولیه ردیف‌ها (برای اینکه انیمیشن درست جواب بده) */
    table tr {
        transition: background-color 0.3s ease;
    }

    /* مرحله ۱: هشدار – قرمز ملایم */
    .row-warning {
        background-color: rgba(255, 80, 80, 0.15);
    }

    /* مرحله ۲: جمع شدن از دو طرف + محو شدن */
    .row-collapse {
        /* برای افکت جمع شدن از دو طرف */
    }

    position: relative;
    overflow: hidden;
    animation: rowCollapseAnim 0.9s ease forwards;
    }

    /* کل محتوا درون ردیف را هدف می‌گیریم تا وسط کمی فاصله بماند */
    .row-collapse td {
        position: relative;
    }

    /* افکت: دو طرف جمع می‌شوند، وسط کمی فاصله می‌ماند، بعد همه‌چیز محو می‌شود */
    @@keyframes rowCollapseAnim {
        0% {
            background-color: rgba(255, 80, 80, 0.15); /* هشدار قرمز */
            opacity: 1;
        }

        40% {
            background-color: rgba(255, 80, 80, 0.28);
        }

        60% {
            /* ایجاد فاصله وسط (با استفاده از padding و scale) */
            transform: scaleX(0.75); /* دو طرف جمع می‌شن */
            opacity: 0.9;
        }

        80% {
            transform: scaleX(0.4); /* بیشتر جمع شدن */
            opacity: 0.6;
        }

        100% {
            transform: scaleX(0.2); /* تقریبا وسط جمع شده */
            opacity: 0; /* محو کامل */
            height: 0;
            padding-top: 0;
            padding-bottom: 0;
            margin: 0;
        }
    }
    /* حالت اولیه ردیف‌ها */
    table tr {
        transition: background-color 0.3s ease;
    }

    /* مرحله ۱: هشدار – خط قرمز ملایم */
    .row-warning {
        background-color: rgba(255, 80, 80, 0.15);
        /* اینجا میشه یه خط قرمز هم اضافه کرد اگه خواستی */
        /* border-bottom: 2px solid rgba(255, 0, 0, 0.4); */
    }

    /* مرحله ۲: جمع شدن از پایین به بالا و محو شدن */
    .row-collapse-bottom-up {
        animation: rowCollapseBottomUpAnim 0.9s ease forwards;
        overflow: hidden; /* برای اینکه خط قرمز موقع جمع شدن بیرون نزنه */
    }

    /* انیمیشن جمع شدن از پایین */
    @@keyframes rowCollapseBottomUpAnim {
        0% {
            background-color: rgba(255, 80, 80, 0.15);
            opacity: 1;
            /* شروع با ارتفاع کامل */
            clip-path: inset(0 0 0 0); /* همه چیز دیده میشه */
        }

        70% {
            background-color: rgba(255, 80, 80, 0.28);
            opacity: 1;
            /* انگار از پایین جمع میشه */
            clip-path: inset(50% 0 0 0); /* بالا تا وسط */
        }

        90% {
            opacity: 0.8;
            /* تقریبا کامل جمع شده */
            clip-path: inset(100% 0 0 0); /* فقط بخش پایین */
        }

        100% {
            opacity: 0;
            clip-path: inset(100% 0 0 0); /* کاملا جمع شده */
            height: 0; /* مطمئن میشیم که ارتفاع هم صفر میشه */
        }
    }
</style>

<div id="deleteModal" class="modal-overlay hidden">
    <div class="modal-box">
        <h3>آیا از حذف این مورد مطمئن هستید؟</h3>

        <div class="modal-actions">
            <button id="confirmDelete" class="btn-gradient">بله حذف کن</button>
            <button id="cancelDelete" class="btn-cancel" style="margin-right:2px;">انصراف</button>
        </div>
    </div>
</div>

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    <a asp-action="Create" class="btn btn-outline-success me-sm-3 me-1">افزودن نقش جدید</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                عنوان نقش
            </th>
            <th>
                تاریخ ایجاد
            </th>
            <th>
                تاریخ ویرایش
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr data-row="@item.Id">
                <td>@item.RoleName</td>
                <td>@item.CreateDate.ToShamsi()</td>
                <td>@item.UpdateDate?.ToShamsi()</td>
                <td>
                    <a class="btn rounded-pill btn-label-warning" asp-area="Admin" asp-controller="Roles" asp-action="Edit" asp-route-id="@item.Id">ویرایش</a>
                    <!-- این دکمه حذف جدید برای مودال -->
                    <button class="btn rounded-pill btn-label-danger delete-btn" data-id="@item.Id">
                        حذف
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @* <script>
        function deleteRole(id)
        {
            if(confirm('آیا از حذف مطمئن هستید؟'))
        {
           $.get("/Admin/Roles/Delete/"+id,function(){
               $("#tr_"+id).hide('slow');
           });
        }

        }
    </script> *@
    <script>
            let deleteId = null;

        document.querySelectorAll(".delete-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                deleteId = this.getAttribute("data-id");
                document.getElementById("deleteModal").classList.remove("hidden");
            });
        });

        document.getElementById("cancelDelete").addEventListener("click", function () {
            document.getElementById("deleteModal").classList.add("hidden");
        });

        document.getElementById("confirmDelete").addEventListener("click", function () {

        fetch(`/Admin/Roles/Delete/${deleteId}`, {
            method: "GET"
        })
            .then(r => r.text())
            .then(() => {
                document.getElementById("deleteModal").classList.add("hidden");

                const tr = document.querySelector(`tr[data-row="${deleteId}"]`);
                if (tr) {
                    tr.classList.add("row-warning"); // فعال کردن خط قرمز
                    setTimeout(() => {
                        tr.classList.add("row-collapse-bottom-up"); // فعال کردن انیمیشن جمع شدن از پایین
                    }, 150);
                    setTimeout(() => {
                        tr.remove(); // حذف نهایی بعد از اتمام انیمیشن
                    }, 1200);
                }
            });
        });

    </script>
}