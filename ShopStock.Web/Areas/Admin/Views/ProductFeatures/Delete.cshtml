@using ShopStock.Domain.Models.Products
@model ProductFeature

@{
    ViewData["Title"] = "حذف ویژگی";
}

<h4>@ViewData["Title"]</h4>

<h3>آیا از حذف مطمئن هستید؟</h3>
<hr />
<div>
    

    <dl class="row">
        <dt class = "col-sm-2">
            عنوان ویزگی
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            مقدار
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Value)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
           تاریخ ایجاد
        </dt>
        <dd class = "col-sm-10">
            @Model.CreateDate.ToShamsi()
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            آخرین ویرایش
        </dt>
        <dd class = "col-sm-10">
            @Model.UpdateDate?.ToShamsi()
        </dd>
    </dl>
    <dl class="row">
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index"asp-route-id="@Model.ProductId" >بازگشت</a>
    </form>
</div>
