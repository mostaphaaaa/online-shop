@using OnlineShop.Domain.ViewModels.Roles
@model AdminEditRoleViewModel

@{
    ViewData["Title"] = "ویرایش نقش";
}

<link href="~/css/admin/role-edit.css" rel="stylesheet" />

<h4 class="fw-bold py-3 mb-4 text-warning">
    @ViewData["Title"]
</h4>

<form asp-action="Edit">

    <input asp-for="RoleId" type="hidden" />

    <div class="row g-4">

        <!-- اطلاعات نقش -->
        <div class="col-md-5">

            <div class="bg-light p-4 rounded shadow-sm">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RoleName"
                           class="form-label fw-bold"></label>

                    <input asp-for="RoleName"
                           class="form-control"
                           placeholder="نام نقش را وارد کنید" />

                    <span asp-validation-for="RoleName"
                          class="text-danger"></span>
                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-warning me-2">
                        ویرایش
                    </button>

                    <a asp-action="Index"
                       class="btn btn-label-secondary">
                        بازگشت
                    </a>

                </div>

            </div>

        </div>

        <!-- دسترسی ها -->
        <div class="col-md-7">

            <div class="card shadow-sm">

                <h5 class="card-header">
                    دسترسی ها
                </h5>

                <div class="card-body">

                    <div class="row">

                        @foreach (var item in Model.Permissions.Where(p => p.ParentId == null))
                        {
                            <div class="col-md mb-md-0 mb-2">

                                <!-- Permission Level 1 -->
                                <div class="form-check custom-option custom-option-basic checked">

                                    <label class="form-check-label custom-option-content"
                                           for="customCheckTemp_@(item.Id)">

                                        <input class="form-check-input"
                                               name="PermissionSelectedIds"
                                               type="checkbox"
                                               value="@item.Id"
                                               id="customCheckTemp_@(item.Id)"
                                               @((Model.PermissionSelectedIds.Any(r => r == item.Id)) ? "checked" : "")>

                                        <span class="custom-option-header">

                                            <span class="h6 mb-0">
                                                @item.DisplayName
                                            </span>

                                            @if (Model.Permissions.Any(p => p.ParentId == item.Id))
                                            {
                                                <button class="btn btn-sm btn-link"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#collapse_@(item.Id)"
                                                        aria-expanded="true">
                                                    ▼
                                                </button>
                                            }

                                        </span>

                                    </label>

                                </div>

                                @if (Model.Permissions.Any(p => p.ParentId == item.Id))
                                {
                                    <div class="collapse show"
                                         id="collapse_@(item.Id)">

                                        @foreach (var sub1 in Model.Permissions.Where(p => p.ParentId == item.Id))
                                        {
                                            <div class="permission-level-2">

                                                <!-- Permission Level 2 -->
                                                <div class="form-check custom-option custom-option-basic checked">

                                                    <label class="form-check-label custom-option-content"
                                                           for="customCheckTemp_@(sub1.Id)">

                                                        <input class="form-check-input"
                                                               name="PermissionSelectedIds"
                                                               type="checkbox"
                                                               value="@sub1.Id"
                                                               id="customCheckTemp_@(sub1.Id)"
                                                               @((Model.PermissionSelectedIds.Any(r => r == sub1.Id)) ? "checked" : "")>

                                                        <span class="custom-option-header">

                                                            <span class="h6 mb-0">
                                                                @sub1.DisplayName
                                                            </span>

                                                            @if (Model.Permissions.Any(p => p.ParentId == sub1.Id))
                                                            {
                                                                <button class="btn btn-sm btn-link"
                                                                        type="button"
                                                                        data-bs-toggle="collapse"
                                                                        data-bs-target="#collapse_@(sub1.Id)"
                                                                        aria-expanded="true">
                                                                    ▼
                                                                </button>
                                                            }

                                                        </span>

                                                    </label>

                                                </div>

                                                @if (Model.Permissions.Any(p => p.ParentId == sub1.Id))
                                                {
                                                    <div class="collapse"
                                                         id="collapse_@(sub1.Id)">

                                                        @foreach (var sub2 in Model.Permissions.Where(p => p.ParentId == sub1.Id))
                                                        {
                                                            <div class="permission-level-3">

                                                                <!-- Permission Level 3 -->
                                                                <div class="form-check custom-option custom-option-basic checked">

                                                                    <label class="form-check-label custom-option-content"
                                                                           for="customCheckTemp_@(sub2.Id)">

                                                                        <input class="form-check-input"
                                                                               name="PermissionSelectedIds"
                                                                               type="checkbox"
                                                                               value="@sub2.Id"
                                                                               id="customCheckTemp_@(sub2.Id)"
                                                                               @((Model.PermissionSelectedIds.Any(r => r == sub2.Id)) ? "checked" : "")>

                                                                        <span class="custom-option-header">

                                                                            <span class="h6 mb-0">
                                                                                @sub2.DisplayName
                                                                            </span>

                                                                        </span>

                                                                    </label>

                                                                </div>

                                                            </div>
                                                        }

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>
            </div>

        </div>

    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/permission-checkboxes.js"></script>
}