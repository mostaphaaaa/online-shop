@model IEnumerable<OnlineShop.Domain.Models.Roles.Role>

@{
    ViewData["Title"] = "مدیریت نقش ها";
}

<link href="~/css/admin/role-index.css" rel="stylesheet" />

<!-- Delete Modal -->
<div id="deleteModal" class="modal-overlay hidden">
    <div class="modal-box">
        <h3>آیا از حذف این مورد مطمئن هستید؟</h3>

        <div class="modal-actions">
            <button id="confirmDelete" class="btn-gradient">
                بله حذف کن
            </button>

            <button id="cancelDelete" class="btn-cancel">
                انصراف
            </button>
        </div>
    </div>
</div>

<!-- Page Title -->
<h4 class="fw-bold py-3 mb-4 text-primary">
    @ViewData["Title"]
</h4>

<!-- Actions -->
<div class="mb-4">
    <a asp-action="Create"
       class="btn btn-outline-success">
        افزودن نقش جدید
    </a>
</div>

<!-- Roles -->
<div class="card">
    <div class="card-header">
        <h5 class="m-0">نقش ها</h5>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>عنوان نقش</th>
                    <th>تاریخ ایجاد</th>
                    <th>تاریخ ویرایش</th>
                    <th>دستورات</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-row="@item.Id">

                        <td>
                            @item.RoleName
                        </td>

                        <td>
                            @item.CreateDate.ToShamsi()
                        </td>

                        <td>
                            @item.UpdateDate?.ToShamsi()
                        </td>

                        <td>
                            <div class="role-actions">

                                <a class="btn btn-label-warning"
                                   asp-area="Admin"
                                   asp-controller="Roles"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id">
                                    ویرایش
                                </a>

                                <button type="button"
                                        class="btn btn-label-danger delete-btn"
                                        data-id="@item.Id">
                                    حذف
                                </button>

                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/role-index.js"></script>
}