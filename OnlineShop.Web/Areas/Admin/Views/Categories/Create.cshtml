@using OnlineShop.Domain.ViewModels.Category
@model AdminCreateCategoryViewModel

@{
    ViewData["Title"] = "افزودن دسته بندی";
}

<link rel="stylesheet" href="~/css/admin/category-create.css" />

<h4 class="fw-bold py-3 mb-4 text-primary">
    @ViewData["Title"]
</h4>

<form asp-action="Create"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="ParentId" />
    <input type="hidden" asp-for="CategoryParentTitle" />

    <div class="alert alert-warning shadow-sm mb-4">
        <h5 class="mb-0">
            @if (Model.CategoryParentTitle == null)
            {
                <span>
                    شما در حال افزودن یک
                    <strong class="text-danger">سر گروه اصلی</strong>
                    هستید.
                </span>
            }
            else
            {
                <span>
                    شما در حال افزودن یک زیر گروه برای دسته بندی
                    <strong class="text-danger">
                        @Model.CategoryParentTitle
                    </strong>
                    هستید.
                </span>
            }
        </h5>
    </div>

    <div class="row g-4">

        <!-- اطلاعات دسته بندی -->
        <div class="col-md-7">

            <div class="bg-light p-4 rounded shadow-sm">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Slug" class="form-label"></label>
                    <input asp-for="Slug" class="form-control" />
                    <span asp-validation-for="Slug"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Image" class="form-label">
                        تصویر دسته بندی
                    </label>

                    <input type="file"
                           asp-for="Image"
                           class="form-control"
                           accept="image/*"
                           onchange="ShowCategoryImage(this)" />

                    <span asp-validation-for="Image"
                          class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit"
                            class="btn btn-primary me-2">
                        ثبت
                    </button>

                    <a asp-action="Index"
                       class="btn btn-label-secondary">
                        بازگشت به لیست
                    </a>
                </div>

            </div>

        </div>

        <!-- تصویر -->
        <div class="col-md-5">

            <div class="bg-light p-4 rounded shadow-sm text-center">

                <h6 class="mb-3">پیش نمایش تصویر</h6>

                <div class="category-image-wrapper">
                    <img src="~/CategoryImages/NoPhoto.jpg"
                         id="categoryImage"
                         class="category-image"
                         alt="تصویر دسته بندی" />
                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/admin/category-create.js"></script>
}