@model OnlineShop.Domain.Models.Categories.Category

@{
    ViewData["Title"] = "حذف گروه";
}

<link rel="stylesheet" href="~/css/admin/category-delete.css" />

<h4 class="fw-bold py-3 mb-4 text-danger">
    @ViewData["Title"]
</h4>

<div class="alert alert-warning shadow-sm mb-4">
    <h5 class="mb-0">
        آیا از حذف گروه
        <strong class="text-primary">
            @Model.Title
        </strong>
        مطمئن هستید؟
    </h5>
</div>

<div class="row g-4">

    <!-- اطلاعات دسته بندی -->
    <div class="col-12 col-md-7">
        <div class="bg-light p-4 rounded shadow-sm">

            <dl class="row mb-0">

                <dt class="col-sm-4 fw-bold">
                    عنوان دسته بندی
                </dt>
                <dd class="col-sm-8">
                    @Model.Title
                </dd>

                <dt class="col-sm-4 fw-bold">
                    عنوان در آدرس بار
                </dt>
                <dd class="col-sm-8">
                    @Model.Slug
                </dd>

                <dt class="col-sm-4 fw-bold">
                    وضعیت
                </dt>
                <dd class="col-sm-8">
                    @if (Model.IsDelete)
                    {
                        <span class="badge bg-label-danger">
                            حذف شده
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-label-success">
                            فعال
                        </span>
                    }
                </dd>

                <dt class="col-sm-4 fw-bold">
                    تاریخ ایجاد
                </dt>
                <dd class="col-sm-8">
                    @Model.CreateDate.ToShamsi()
                </dd>

                @if (Model.UpdateDate != null)
                {
                    <dt class="col-sm-4 fw-bold">
                        تاریخ ویرایش
                    </dt>
                    <dd class="col-sm-8">
                        @Model.UpdateDate.Value.ToShamsi()
                    </dd>
                }

            </dl>

        </div>
    </div>

    <!-- تصویر -->
    <div class="col-12 col-md-5">
        <div class="bg-light p-4 rounded shadow-sm text-center">

            <h6 class="mb-3">
                تصویر دسته بندی
            </h6>

            <div class="image-wrapper mx-auto">
                <img src="~/CategoryImages/@Model.ImageName"
                     class="category-image"
                     alt="تصویر دسته بندی" />
            </div>

        </div>
    </div>

</div>

<div class="mt-4 d-flex flex-wrap gap-2">

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="btn btn-danger px-4">
            حذف دسته بندی
        </button>
    </form>

    <a asp-action="Index"
       class="btn btn-label-secondary">
        بازگشت به لیست
    </a>

</div>