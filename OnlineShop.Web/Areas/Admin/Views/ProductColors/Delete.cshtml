@using OnlineShop.Domain.Models.Products
@model ProductColor

@{
    ViewData["Title"] = "حذف رنگ";
}

<link rel="stylesheet" href="~/css/admin/product-color-delete.css" />

<h4 class="fw-bold py-3 mb-4 text-danger">
    @ViewData["Title"]
</h4>

<div class="alert alert-danger shadow-sm mb-4">
    <h5 class="mb-0">
        آیا از حذف این رنگ مطمئن هستید؟
    </h5>
</div>

<div class="bg-light p-4 rounded shadow-sm">

    <dl class="row mb-0">

        <dt class="col-sm-3 fw-bold">
            عنوان رنگ
        </dt>
        <dd class="col-sm-9">
            <div class="color-name">
                <span class="color-swatch"
                      style="background-color: @Model.Code;">
                </span>

                <span>
                    @Model.Name
                </span>
            </div>
        </dd>

        <dt class="col-sm-3 fw-bold">
            کد رنگ
        </dt>
        <dd class="col-sm-9">
            <code>@Model.Code</code>
        </dd>

        <dt class="col-sm-3 fw-bold">
            قیمت
        </dt>
        <dd class="col-sm-9">
            <span class="badge bg-label-success">
                @Model.Price.ToTooman()
            </span>
        </dd>

        <dt class="col-sm-3 fw-bold">
            موجودی
        </dt>
        <dd class="col-sm-9">
            @Model.Quantity
        </dd>

        <dt class="col-sm-3 fw-bold">
            وضعیت
        </dt>
        <dd class="col-sm-9">
            @if (Model.IsDefault)
            {
                <span class="badge bg-label-primary">
                    رنگ پیش‌فرض
                </span>
            }
            else
            {
                <span class="badge bg-label-secondary">
                    رنگ عادی
                </span>
            }
        </dd>

    </dl>

</div>

<div class="mt-4 d-flex flex-wrap gap-2">

    <form asp-action="Delete">

        <input type="hidden"
               asp-for="Id" />

        <button type="submit"
                class="btn btn-danger px-4">
            حذف رنگ
        </button>

    </form>

    <a asp-action="Index"
       asp-route-id="@Model.ProductId"
       class="btn btn-label-secondary">
        بازگشت به لیست رنگ‌ها
    </a>

</div>