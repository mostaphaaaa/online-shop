@using OnlineShop.Domain.Models.Products
@model IEnumerable<ProductFeature>

@{
    ViewData["Title"] = ViewBag.Product;
}

<link rel="stylesheet" href="~/css/admin/product-feature-index.css" />

<h4 class="fw-bold py-3 mb-4">
    <span class="text-muted fw-light">محصولات / ویژگی‌ها /</span>
    @ViewBag.Product
</h4>

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="m-0">ویژگی‌های محصول</h5>

        <a asp-action="Create"
           asp-route-id="@ViewBag.ProductId"
           class="btn btn-outline-primary">
            افزودن ویژگی جدید
        </a>
    </div>

    <div class="table-responsive">

        <table class="table">

            <thead>
                <tr>
                    <th>عنوان ویژگی</th>
                    <th>مقدار</th>
                    <th>دستورات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.Name
                        </td>

                        <td>
                            @item.Value
                        </td>

                        <td>
                            <div class="product-feature-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-label-warning">
                                    ویرایش
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-label-danger">
                                    حذف
                                </a>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<div class="mt-4">
    <a asp-action="Index"
       asp-controller="Products"
       class="btn btn-label-secondary">
        بازگشت به لیست محصولات
    </a>
</div>