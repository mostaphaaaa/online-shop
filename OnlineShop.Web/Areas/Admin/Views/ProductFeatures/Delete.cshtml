@using OnlineShop.Domain.Models.Products
@model ProductFeature

@{
    ViewData["Title"] = "حذف ویژگی";
}

<h4 class="fw-bold py-3 mb-4 text-danger">
    @ViewData["Title"]
</h4>

<div class="alert alert-danger shadow-sm mb-4">
    <h5 class="mb-0">
        آیا از حذف این ویژگی مطمئن هستید؟
    </h5>
</div>

<div class="bg-light p-4 rounded shadow-sm">

    <dl class="row mb-0">

        <dt class="col-sm-3 fw-bold">
            عنوان ویژگی
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>

        <dt class="col-sm-3 fw-bold">
            مقدار
        </dt>
        <dd class="col-sm-9">
            @Model.Value
        </dd>

        <dt class="col-sm-3 fw-bold">
            تاریخ ایجاد
        </dt>
        <dd class="col-sm-9">
            @Model.CreateDate.ToShamsi()
        </dd>

        <dt class="col-sm-3 fw-bold">
            آخرین ویرایش
        </dt>
        <dd class="col-sm-9">
            @Model.UpdateDate?.ToShamsi()
        </dd>

    </dl>

</div>

<div class="mt-4 d-flex flex-wrap gap-2">

    <form asp-action="Delete">

        <input type="hidden"
               asp-for="Id" />

        <button type="submit"
                class="btn btn-danger px-4">
            حذف ویژگی
        </button>

    </form>

    <a asp-action="Index"
       asp-route-id="@Model.ProductId"
       class="btn btn-label-secondary">
        بازگشت
    </a>

</div>