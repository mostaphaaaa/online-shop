@using OnlineShop.Domain.ViewModels.Product
@model ProductFeatureViewModel

@{
    ViewData["Title"] = "افزودن ویژگی";
}

<h4 class="fw-bold py-3 mb-4 text-primary">
    @ViewData["Title"]
</h4>

<div class="row">

    <div class="col-12 col-md-7">

        <div class="bg-light p-4 rounded shadow-sm">

            <form asp-action="Create" method="post">

                <input type="hidden" asp-for="ProductId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Value"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Value"
                           class="form-control" />

                    <span asp-validation-for="Value"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-primary px-4">
                        ثبت ویژگی
                    </button>

                    <a asp-action="Index"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-label-secondary">
                        بازگشت
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}