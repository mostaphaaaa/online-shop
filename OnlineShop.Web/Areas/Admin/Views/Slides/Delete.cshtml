@using OnlineShop.Domain.Models.Slider
@model Slide

@{
    ViewData["Title"] = "حذف";
}

<h1>@ViewData["Title"]</h1>

<h3>آیا از حذف این اسلاید مطمئن هستید؟</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Url)
        </dt>
        <dd class = "col-sm-10">
            <a href="@Model.Url" target="_blank">@Model.Title</a>
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsBlank)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsBlank)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.StartDate?.ToShamsi()
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ExpireDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.ExpireDate?.ToShamsi()
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VisitCount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VisitCount)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreateDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.CreateDate.ToShamsi()
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UpdateDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.UpdateDate?.ToShamsi();
        </dd>
    </dl>
    <dl class="row">
        <img src="/Sliders/@Model.ImageName" class="img-thumbnail" style="max-width:200px"/>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index">بازگشت به لیست</a>
    </form>
    <form asp-action="PermenantDelete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="حذف دائمی" class="btn btn-outline-danger" />
    </form>
</div>
