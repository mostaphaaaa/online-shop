@using OnlineShop.Domain.ViewModels.Product
@model AdminCreateProductViewModel

@{
    ViewData["Title"] = "افزودن کالای جدید";
}
<link href="~/css/admin/product-create.css" rel="stylesheet" />
<link rel="stylesheet" href="~/AdminAssets/assets/vendor/libs/tagify/tagify.css" />


<h1 class="text-primary mb-4">@ViewData["Title"]</h1>
<hr />

<form asp-action="Create" enctype="multipart/form-data">

    <div class="row mt-4 g-4">

        <!-- اطلاعات محصول -->
        <div class="col-12 col-md-7">

            <div class="bg-light p-4 rounded shadow-sm">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Title" class="control-label fw-bold"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price" class="control-label fw-bold"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ShortDescription" class="control-label fw-bold"></label>
                    <textarea asp-for="ShortDescription" class="form-control"></textarea>
                    <span asp-validation-for="ShortDescription" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Review" class="control-label fw-bold"></label>
                    <textarea asp-for="Review" class="form-control"></textarea>
                    <span asp-validation-for="Review" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DetailReview" class="control-label fw-bold"></label>
                    <textarea asp-for="DetailReview" class="form-control"></textarea>
                    <span asp-validation-for="DetailReview" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Count" class="control-label fw-bold"></label>
                    <input asp-for="Count" class="form-control" />
                    <span asp-validation-for="Count" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label for="TagifyCustomInlineSuggestion" class="form-label fw-bold">
                        کلمات کلیدی
                    </label>
                    <input id="TagifyCustomInlineSuggestion"
                           class="form-control"
                           name="Tags"
                           value="" />
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input"
                           asp-for="IsActive" />

                    <label class="form-check-label fw-bold" asp-for="IsActive">
                    </label>
                </div>

            </div>

        </div>

        <!-- تصویر و دسته بندی -->
        <div class="col-12 col-md-5">

            <div class="bg-light p-4 rounded shadow-sm">

                <!-- تصویر -->
                <div class="text-center mb-4">

                    <div class="image-wrapper mx-auto">
                        <img src="/Avatars/NoPhoto.jpg"
                             id="imgProduct"
                             class="img-fluid rounded shadow-lg product-image" />
                    </div>

                </div>

                <div class="form-group mb-3">
                    <label asp-for="ImageName" class="control-label fw-bold"></label>

                    <input asp-for="ImageFile"
                           class="form-control"
                           onchange="ShowpImage(this);" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger"></span>
                </div>

                <hr />

                <!-- دسته بندی اصلی -->
                <div class="form-group mb-3">
                    <label asp-for="CategoryId"
                           class="control-label fw-bold">
                        دسته بندی اصلی
                    </label>

                    <select class="form-control"
                            id="main-category"
                            onchange="loadSubCategory(this.value)">
                        <option value="">انتخاب دسته بندی</option>
                    </select>
                </div>

                <!-- دسته بندی فرعی -->
                <div class="form-group mb-3">
                    <label asp-for="CategoryId"
                           class="control-label fw-bold">
                        دسته بندی فرعی
                    </label>

                    <select class="form-control"
                            id="sub-category"
                            onchange="loadFinalCategory(this.value)">
                        <option value="">انتخاب دسته بندی</option>
                    </select>
                </div>

                <!-- دسته بندی نهایی -->
                <div class="form-group mb-3">
                    <label asp-for="CategoryId"
                           class="control-label fw-bold">
                        دسته بندی نهایی
                    </label>

                    <select asp-for="CategoryId"
                            class="form-control"
                            id="final-category">
                        <option value="">انتخاب دسته بندی</option>
                    </select>
                </div>

                <hr />

                <!-- گالری -->
                <div class="form-group">
                    <label asp-for="Galleries"
                           class="control-label fw-bold">
                    </label>

                    <input asp-for="Galleries"
                           class="form-control"
                           multiple />

                    <span asp-validation-for="Galleries"
                          class="text-danger"></span>
                </div>

            </div>

        </div>

    </div>

    <!-- دکمه ها -->
    <div class="mt-4 d-flex flex-wrap gap-2">

        <button type="submit" class="btn btn-primary px-4">
            افزودن کالا
        </button>

        <a asp-action="Index"
           class="btn btn-outline-slack">
            بازگشت به لیست
        </a>

    </div>

</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script src="~/AdminAssets/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/js/admin/product-create.js"></script>
}

