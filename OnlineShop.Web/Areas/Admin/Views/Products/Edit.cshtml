@using OnlineShop.Domain.ViewModels.Product
@model AdminEditProductViewModel

@{
    ViewData["Title"] = "ویرایش کالا";
}

<link rel="stylesheet" href="~/AdminAssets/assets/vendor/libs/tagify/tagify.css" />
<link rel="stylesheet" href="~/css/admin/product-edit.css" />

<h1 class="text-warning mb-4">@ViewData["Title"]</h1>

<hr />

<input type="hidden" asp-for="CategoryId" id="CategoryId" />

<form asp-action="Edit" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="row mt-4 g-4">

        <!-- اطلاعات محصول -->
        <div class="col-12 col-md-7">

            <div class="bg-light p-4 rounded shadow-sm">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Title"
                           class="control-label fw-bold"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price"
                           class="control-label fw-bold"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price"
                          class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ShortDescription"
                           class="control-label fw-bold"></label>
                    <textarea asp-for="ShortDescription"
                              class="form-control"></textarea>
                    <span asp-validation-for="ShortDescription"
                          class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Review"
                           class="control-label fw-bold"></label>
                    <textarea asp-for="Review"
                              class="form-control"></textarea>
                    <span asp-validation-for="Review"
                          class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DetailReview"
                           class="control-label fw-bold"></label>
                    <textarea asp-for="DetailReview"
                              class="form-control"></textarea>
                    <span asp-validation-for="DetailReview"
                          class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Count"
                           class="control-label fw-bold"></label>
                    <input asp-for="Count" class="form-control" />
                    <span asp-validation-for="Count"
                          class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label for="TagifyCustomInlineSuggestion"
                           class="form-label fw-bold">
                        کلمات کلیدی
                    </label>

                    <input id="TagifyCustomInlineSuggestion"
                           asp-for="Tags"
                           class="form-control" />
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input"
                           asp-for="IsActive" />

                    <label class="form-check-label fw-bold"
                           asp-for="IsActive">
                    </label>
                </div>

            </div>

        </div>


        <!-- تصویر و دسته بندی -->
        <div class="col-12 col-md-5">

            <div class="bg-light p-4 rounded shadow-sm">

                <!-- تصویر اصلی -->
                <div class="text-center mb-4">

                    <div class="image-wrapper mx-auto">
                        <img src="~/ProductImages/@Model.ImageName"
                             id="imgProduct"
                             class="img-fluid rounded shadow-lg product-image" />
                    </div>

                </div>

                <div class="form-group mb-3">
                    <label asp-for="ImageName"
                           class="control-label fw-bold"></label>

                    <input asp-for="ImageFile"
                           class="form-control"
                           onchange="ShowpImage(this);" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger"></span>
                </div>

                <hr />

                <!-- دسته بندی اصلی -->
                <div class="form-group mb-3">

                    <label asp-for="CategoryId"
                           class="control-label fw-bold">
                        دسته بندی اصلی
                    </label>

                    <select class="form-control"
                            id="main-category"
                            asp-items="@ViewBag.main_category"
                            onchange="loadSubCategory(this.value)">
                        <option value="">انتخاب دسته بندی</option>
                    </select>

                </div>

                <!-- دسته بندی فرعی -->
                <div class="form-group mb-3">

                    <label asp-for="CategoryId"
                           class="control-label fw-bold">
                        دسته بندی فرعی
                    </label>

                    <select class="form-control"
                            id="sub-category"
                            asp-items="@ViewBag.sub_category"
                            onchange="loadFinalCategory(this.value)">
                        <option value="">انتخاب دسته بندی</option>
                    </select>

                </div>

                <!-- دسته بندی نهایی -->
                <div class="form-group mb-3">

                    <label asp-for="CategoryId"
                           class="control-label fw-bold">
                        دسته بندی نهایی
                    </label>

                    <select asp-for="CategoryId"
                            class="form-control"
                            id="final-category"
                            asp-items="@ViewBag.CategoryId">
                        <option value="">انتخاب دسته بندی</option>
                    </select>

                </div>

                <hr />

                <!-- گالری -->
                <div class="form-group mb-3">

                    <label asp-for="Galleries"
                           class="control-label fw-bold">
                        انتخاب تصاویر گالری
                    </label>

                    <input asp-for="Galleries"
                           class="form-control"
                           multiple />

                    <span asp-validation-for="Galleries"
                          class="text-danger"></span>

                </div>


                <!-- تصاویر فعلی گالری -->
                @if (Model.ProductGalleries != null &&
                     Model.ProductGalleries.Any())
                {
                    <label class="control-label fw-bold">
                        تصاویر گالری
                    </label>

                    <div class="row">

                        @foreach (var image in Model.ProductGalleries)
                        {
                            <div class="col-5 m-2 gallery-item"
                                 id="gallery-@(image.Id)">

                                <img src="~/ProductImages/@image.ImageName"
                                     class="img-thumbnail gallery-image" />

                                <button type="button"
                                        class="btn btn-danger btn-sm mt-2 remove-gallery"
                                        data-id="@image.Id">
                                    حذف
                                </button>

                            </div>
                        }

                    </div>
                }

                <div id="deleted-gallery-container"></div>

                <!-- پیش نمایش تصاویر جدید -->
                <div class="row mt-2"
                     id="gallery-preview">
                </div>

            </div>

        </div>

    </div>


    <!-- دکمه ها -->
    <div class="mt-4 d-flex flex-wrap gap-2">

        <button type="submit"
                class="btn btn-warning px-4">
            ویرایش کالا
        </button>

        <a asp-action="Index"
           class="btn btn-outline-slack">
            بازگشت به لیست
        </a>

    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script src="~/AdminAssets/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/js/admin/product-edit.js"></script>
}

