@using OnlineShop.Domain.ViewModels.User
@model AdminFilterUserViewModel

@{
    ViewData["Title"] = "لیست کاربران";
    ViewBag.Url = "/Admin/Users";
}

<link rel="stylesheet" href="~/css/admin/user-index.css" />

<h4 class="fw-bold py-3 mb-4">
    <span class="text-muted fw-light">کاربران /</span>
    @ViewData["Title"]
</h4>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h5 class="m-0">فیلترها</h5>

        <button class="btn btn-sm btn-link"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#filterCardBody"
                aria-expanded="false"
                aria-controls="filterCardBody">
            نمایش فیلترها
        </button>
    </div>

    <div class="collapse" id="filterCardBody">
        <form asp-action="Index" method="get" id="filter-search">

            <input asp-for="PageId" type="hidden" id="PageId" />

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DeleteStatus" class="form-label"></label>

                        <select asp-for="DeleteStatus" class="form-select">
                            <option value="">وضعیت حذف</option>
                            <option value="All">همه</option>
                            <option value="Deleted">حذف شده</option>
                            <option value="NotDeleted">حذف نشده</option>
                        </select>
                    </div>

                </div>

                <div class="pt-4">
                    <button type="submit" class="btn btn-primary me-sm-3 me-1">
                        جستجو
                    </button>

                    <a asp-action="Index" class="btn btn-label-secondary">
                        حذف فیلترها
                    </a>
                </div>
            </div>

        </form>
    </div>
</div>

<!-- Users -->
<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="m-0">کاربران</h5>

        <a asp-action="Create" class="btn btn-outline-info">
            افزودن کاربر جدید
        </a>
    </div>

    <!-- Page Size -->
    <div class="user-list-toolbar">
        <label class="form-label mb-0">
            تعداد نمایش:
        </label>

        <select class="form-select user-page-size"
                name="TakeEntity"
                onchange="changeTake(this.value)">

            <option value="1" selected="@(Model.TakeEntity == 1)">1</option>
            <option value="2" selected="@(Model.TakeEntity == 2)">2</option>
            <option value="3" selected="@(Model.TakeEntity == 3)">3</option>
            <option value="5" selected="@(Model.TakeEntity == 5)">5</option>

        </select>
    </div>

    <div class="table-responsive">

        <table class="table">

            <thead>
                <tr>
                    <th>کاربر</th>
                    <th>نام</th>
                    <th>وضعیت</th>
                    <th>دستورات</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.Entities)
                {
                    <tr class="@(item.IsDelete ? "table-danger" : "")">

                        <td>
                            <div class="user-info">

                                <img src="/Avatars/@item.Avatar"
                                     alt="Avatar"
                                     class="user-avatar" />

                                <div class="user-details">
                                    <span class="fw-semibold">
                                        @item.UserName
                                    </span>

                                    <small class="text-muted">
                                        @item.Email
                                    </small>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="fw-semibold">
                                @item.FirstName @item.LastName
                            </span>
                        </td>

                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-label-success">
                                    فعال
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-label-secondary">
                                    غیر فعال
                                </span>
                            }
                        </td>

                        <td>
                            <div class="user-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-label-warning">
                                    ویرایش
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-label-danger">
                                    حذف
                                </a>

                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="user-pagination">
        <partial name="_AdminPagination"
                 model="@Model.GetCurrentPaging()" />
    </div>

</div>

@section Scripts {
    <script src="~/js/admin/user-index.js"></script>
}