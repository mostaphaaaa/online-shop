@model OnlineShop.Domain.Models.Users.User

@{
    ViewData["Title"] = "حذف کاربر";

    string fullName = !string.IsNullOrWhiteSpace(Model.FirstName) &&
                      !string.IsNullOrWhiteSpace(Model.LastName)
        ? $"{Model.FirstName} {Model.LastName}"
        : Model.UserName;
}
<link rel="stylesheet" href="~/css/admin/user-delete.css" />
<h4 class="fw-bold py-3 mb-4 text-danger">
    @ViewData["Title"]
</h4>

<div class="alert alert-danger shadow-sm mb-4">
    <h5 class="mb-0">
        آیا از حذف کاربر
        <strong>@fullName</strong>
        مطمئن هستید؟
    </h5>
</div>

<div class="row g-4">

    <!-- User Information -->
    <div class="col-md-7">
        <div class="bg-light p-4 rounded shadow-sm">

            <dl class="row mb-0">

                <dt class="col-sm-3">
                    نام
                </dt>
                <dd class="col-sm-9">
                    @Model.FirstName
                </dd>

                <dt class="col-sm-3">
                    نام خانوادگی
                </dt>
                <dd class="col-sm-9">
                    @Model.LastName
                </dd>

                <dt class="col-sm-3">
                    نام کاربری
                </dt>
                <dd class="col-sm-9">
                    @Model.UserName
                </dd>

                <dt class="col-sm-3">
                    ایمیل
                </dt>
                <dd class="col-sm-9">
                    @Model.Email
                </dd>

                <dt class="col-sm-3">
                    موبایل
                </dt>
                <dd class="col-sm-9">
                    @Model.Mobile
                </dd>

                <dt class="col-sm-3">
                    کد ملی
                </dt>
                <dd class="col-sm-9">
                    @Model.NationalCode
                </dd>

                <dt class="col-sm-3">
                    وضعیت
                </dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-label-success">
                            فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-label-secondary">
                            غیر فعال
                        </span>
                    }
                </dd>

                <dt class="col-sm-3">
                    تاریخ ایجاد
                </dt>
                <dd class="col-sm-9">
                    @Model.CreateDate.ToShamsi()
                </dd>

                @if (Model.UpdateDate != null)
                {
                    <dt class="col-sm-3">
                        تاریخ ویرایش
                    </dt>
                    <dd class="col-sm-9">
                        @Model.UpdateDate.Value.ToShamsi()
                    </dd>
                }

                <dt class="col-sm-3">
                    نقش های کاربر
                </dt>
                <dd class="col-sm-9">
                    @(Model.UserInRoles.Any()
                        ? string.Join(", ", Model.UserInRoles.Select(r => r.Role.RoleName))
                        : "کاربر عادی")
                </dd>

            </dl>

        </div>
    </div>

    <!-- Avatar -->
    <div class="col-md-5">
        <div class="bg-light p-4 rounded shadow-sm text-center">

            <h6 class="mb-3">
                تصویر کاربر
            </h6>

            <img src="~/Avatars/@Model.Avatar"
                 class="user-delete-avatar"
                 alt="تصویر کاربر" />

        </div>
    </div>

</div>

<!-- Actions -->
<div class="mt-4 d-flex flex-wrap gap-2">

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            حذف کاربر
        </button>
    </form>

    <a asp-action="Index"
       class="btn btn-label-secondary">
        بازگشت به لیست
    </a>

</div>