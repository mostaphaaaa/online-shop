@model OnlineShop.Domain.ViewModels.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر کلمه عبور";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row ui-box">
    <div class="col-md-8">
        <form asp-action="ChangePassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="OldPassword" class="control-label"></label>
                <input asp-for="OldPassword" class="form-control mt-1" />
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control mt-1" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RePassword" class="control-label mt-1"></label>
                <input asp-for="RePassword" class="form-control" />
                <span asp-validation-for="RePassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="ذخیره تغییرات" class="btn btn-success mt-3" />
            </div>
        </form>
    </div>
</div>

