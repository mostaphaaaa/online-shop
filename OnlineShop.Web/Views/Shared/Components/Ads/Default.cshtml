@using OnlineShop.Domain.Models.Ads
@model IEnumerable<Ads>

@{
    int zoneId = (int)ViewBag.ZoneId;
 }

 @switch(zoneId)
{
    case 1:
        {
            <div class="row mb-3 d-sm-block d-none">
            <div class="col-12">
                <!-- start of banner -->
                <div class="banner-img">
                    @foreach(var item in Model)
                        {
                            <a href="@item.Url"><img src="/AdsImages/@item.ImageName" alt="@item.Title"></a>
                        }
                    </div>
                <!-- end of banner -->
            </div>
            </div>
            break;
        }
    case 2:
        {
            <div class="col-lg-4">
                <div class="row">
                    @foreach(var item in Model)
                    {
                        <div class="col-lg-12 col-6 mb-lg-3">
                            <!-- start of banner -->
                            <div class="banner-img banner-side-main-slider bg-position-right">
                                <a href="@item.Url"
                                   style="background-image: url(/AdsImages/@item.ImageName);height:220px;">
                                    <img src="/AdsImages/@item.ImageName" alt="@item.Title">
                                </a>
                            </div>
                            <!-- end of banner -->
                        </div>
                    }
                </div>
            </div>
            break;
        }
    case 3:
        {
            <div class="row mb-5">
                @foreach(var item in Model)
                {
                    <div class="col-md-6 mb-lg-0 mb-3">
                        <!-- start of banner -->
                        <div class="banner-img">
                            <a href="@item.Url">
                                <img src="/AdsImages/@item.ImageName" alt="@item.Title">
                            </a>
                        </div>
                        <!-- end of banner -->
                    </div>
                }
            </div>
            break;
        }
    case 4:
        {
            <div class="row mb-5">
                @foreach(var item in Model)
                {
                    <div class="col-md-3 col-6 mb-lg-0 mb-3">
                        <!-- start of banner -->
                        <div class="banner-img">
                            <a href="@item.Url">
                                <img src="/AdsImages/@item.ImageName" alt="@item.Title">
                            </a>
                        </div>
                        <!-- end of banner -->
                    </div>
                }
            </div>
            break;
        }
    case 5:
        {
            <div class="row mb-5">
                @foreach(var item in Model)
                {
                    <div class="col-md-6 mb-lg-0 mb-3">
                        <!-- start of banner -->
                        <div class="banner-img">
                            <a href="@item.Url">
                                <img src="~/AdsImages/@item.ImageName" alt="@item.Title">
                            </a>
                        </div>
                        <!-- end of banner -->
                    </div>
                }
            </div>
            break;
        }
}